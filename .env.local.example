# ─────────────────────────────────────────────
# ALTUNEL BİSİKLET — Ortam Değişkenleri
# Bu dosyayı .env.local olarak kopyalayın
# ─────────────────────────────────────────────

# Supabase (https://app.supabase.com > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Stripe (https://dashboard.stripe.com > Developers > API keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Uygulama URL (production'da gerçek domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin e-posta (bu adres is_admin = true olarak ayarlanacak)
ADMIN_EMAIL=admin@altunelbisiklet.com
